{
  "name": "timelake-monorepo",
  "private": true,
  "license": "Apache-2.0",
  "workspaces": [
    "dashboard",
    "packages/*"
  ],
  "scripts": {
    "brand:editor": "cd brand && bun install && bun editor.mjs",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "bun run --filter '*' typecheck",
    "check": "bun run lint && bun run format:check && bun run typecheck"
  },
  "devDependencies": {
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0"
  }
}
