{
  "name": "@timelake/client",
  "version": "0.7.0",
  "description": "Read and append to Timelake tables from the browser, Node, Cloudflare Workers, or serverless functions (WASM reader and writer, Zod-typed rows)",
  "license": "Apache-2.0",
  "homepage": "https://timelake.dev/docs/typescript",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/polythings/timelake.git",
    "directory": "packages/timelake-client"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./workers": {
      "types": "./dist/workers.d.ts",
      "default": "./dist/workers.js"
    },
    "./timelake.wasm": "./dist/wasm/timelake.wasm"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun scripts/build.mjs",
    "prepack": "bun run build",
    "build:wasm": "bash scripts/build-wasm.sh",
    "check:wasm": "bash scripts/build-wasm.sh --check",
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.json && tsc -p test/tsconfig.json"
  },
  "peerDependencies": {
    "zod": "^4"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "binaryen": "132.0.0",
    "typescript": "^7",
    "zod": "^4"
  }
}
